{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lista-assistir",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lista-assistir",
      "database_id": "dfe6e479-1090-449d-a1ca-a16f700126f8",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
